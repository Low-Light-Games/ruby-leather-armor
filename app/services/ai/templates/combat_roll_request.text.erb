=== RELEVANT RULES ===
<% @combat_roll_request_context.relevant_rules.each_with_index do |rule, idx| -%>
<%= idx + 1 %>. **<%= rule[:name] %>** (slug: `<%= rule[:slug] %>`)
   <%= rule[:body].to_s.strip.gsub("\n", "\n   ") %>

<% end -%>
