<!DOCTYPE html>
<html>
  <head>
    <title>Leather Armor — Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%
      app_url_host = ENV["APP_URL"].present? ? URI.parse(ENV["APP_URL"]).host : nil
      app_base     = (app_url_host && request.host == app_url_host) ? "" : "/app"
      main_url     = app_url_host ? ENV["APP_URL"].sub("//#{app_url_host}", "//#{app_url_host.sub(/\Aapp\./, '')}") : ""
    %>
    <script>
      window.AppRoutes = {
        appBase:           "<%= app_base %>",
        mainUrl:           "<%= main_url %>",
        login:             "<%= app_base %>/login",
        logout:            "<%= app_base %>/logout",
        currentUser:       "<%= app_base %>/current_user",
        sheets:            "<%= app_base %>/sheets",
        adventures:        "<%= app_base %>/adventures",
        newAdventure:      "<%= app_base %>/adventures/new",
        stories:           "<%= app_base %>/stories",
        featDefinitions:   "<%= app_base %>/feat_definitions",
        spellDefinitions:  "<%= app_base %>/spell_definitions",
        itemDefinitions:   "<%= app_base %>/item_definitions",
        featureFlags:      "<%= app_base %>/feature_flags",
        onboardingComplete: "<%= app_base %>/onboarding/complete"
      };
    </script>
    <%= render 'admin/shared/navbar_styles' %>
  </head>

  <body style="margin:0; background:#ffffff; font-family:Arial,sans-serif;">
    <%= render 'admin/shared/navbar' %>
    <%= yield %>
  </body>
</html>
