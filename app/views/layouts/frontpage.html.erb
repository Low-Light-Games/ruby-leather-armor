<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Leather Armor — Tabletop RPG Character Sheets &amp; Adventures</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Build characters, forge stories, and play epic tabletop campaigns — all in one place.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "frontpage", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "frontpage", "data-turbo-track": "reload", defer: true %>
  </head>

  <body style="margin:0; background:#0f0f14;">
    <%= yield %>
  </body>
</html>
