<!DOCTYPE html>
<html>
  <head>
    <title>Leather Armor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%#
      Route config for the JS layer.
      On the subdomain (APP_URL set), nginx adds the /app/ prefix automatically,
      so paths must NOT include it — the browser sends /adventures and nginx
      rewrites to /app/adventures before Rails sees it.
      Locally (no APP_URL), there is no nginx rewrite, so /app/ must be included.
    %>
    <% app_base = ENV["APP_URL"].present? ? "" : "/app" %>
    <script>
      window.AppRoutes = {
        appBase:           "<%= app_base %>",
        login:             "<%= app_base %>/login",
        logout:            "<%= app_base %>/logout",
        currentUser:       "<%= app_base %>/current_user",
        sheets:            "<%= app_base %>/sheets",
        adventures:        "<%= app_base %>/adventures",
        newAdventure:      "<%= app_base %>/adventures/new",
        stories:           "<%= app_base %>/stories",
        featDefinitions:   "<%= app_base %>/feat_definitions",
        spellDefinitions:  "<%= app_base %>/spell_definitions",
        itemDefinitions:   "<%= app_base %>/item_definitions",
        featureFlags:      "<%= app_base %>/feature_flags",
        onboardingComplete: "<%= app_base %>/onboarding/complete"
      };
    </script>
  </head>

  <body style="margin:0; background:hsl(40,30%,88%); font-family:'IM Fell English','Georgia',serif;">
    <%= yield %>
    <footer style="text-align:center;padding:16px;font-size:12px;color:hsl(20,10%,40%);border-top:1px solid hsl(20,12%,55%);margin-top:40px;font-family:'Courier Prime','Courier New',monospace;letter-spacing:0.06em;">
      <a href="/legal" style="color:hsl(20,10%,40%);text-decoration:underline;">Open Game License</a>
      &nbsp;&nbsp;·&nbsp;&nbsp;
      <a href="/privacy" style="color:hsl(20,10%,40%);text-decoration:underline;">Privacy</a>
    </footer>
  </body>
</html>
