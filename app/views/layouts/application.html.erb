<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <%= yield %>
    <footer style="text-align:center;padding:16px;font-size:12px;color:#999;border-top:1px solid #eee;margin-top:40px;">
      <a href="/legal" style="color:#999;text-decoration:underline;">Open Game License</a>
    </footer>
  </body>
</html>
