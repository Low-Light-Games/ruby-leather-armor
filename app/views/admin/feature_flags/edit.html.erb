<div class="feature-flags-edit-page">
  <p class="breadcrumb"><%= link_to "← All flags", admin_feature_flags_path %></p>
  <h1><code><%= @flag.key %></code></h1>
  <p class="page-desc"><%= @flag.description %></p>

  <% if flash[:alert] %>
    <div class="flash-alert"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with model: @flag, url: admin_feature_flag_path(@flag), method: :patch, local: true,
                html: { class: "flag-form", data: { controller: "feature-flag-edit" } } do |f| %>

    <fieldset class="ff-section">
      <legend>Mode</legend>
      <% FeatureFlag::MODES.each do |m| %>
        <label class="radio-row">
          <%= f.radio_button :mode, m, data: { action: "change->feature-flag-edit#refresh" } %>
          <span class="radio-label"><%= m.upcase %></span>
          <span class="radio-hint"><%= mode_hint(m) %></span>
        </label>
      <% end %>
    </fieldset>

    <fieldset class="ff-section bucketing-section" data-feature-flag-edit-target="bucketingSection">
      <legend>Bucketing strategy</legend>
      <% FeatureFlag::STRATEGIES.each do |s| %>
        <label class="radio-row">
          <%= f.radio_button :bucketing_strategy, s, data: { action: "change->feature-flag-edit#refresh" } %>
          <span class="radio-label"><%= s.upcase %></span>
          <span class="radio-hint"><%= strategy_hint(s) %></span>
        </label>
      <% end %>
    </fieldset>

    <fieldset class="ff-section granular-section" data-feature-flag-edit-target="granularSection">
      <legend>Granular: user IDs that are ON</legend>
      <p class="hint">Enter user IDs separated by commas, spaces, or newlines. Everyone else is OFF.</p>
      <%= f.text_area :granular_user_ids_raw,
            rows: 4,
            value: @flag.granular_user_ids.join(", "),
            placeholder: "e.g.  3, 17, 42",
            class: "field-textarea" %>
    </fieldset>

    <fieldset class="ff-section modulo-section" data-feature-flag-edit-target="moduloSection">
      <legend>Modulo: rollout</legend>
      <div class="modulo-row">
        <label>
          Divisor (2–10)
          <%= f.number_field :modulo_divisor, in: FeatureFlag::MODULO_DIVISOR_RANGE,
                step: 1, class: "field-number" %>
        </label>
        <p class="hint">A user is ON when <code>user.id % divisor</code> matches one of the remainders below.</p>
      </div>
      <div class="modulo-remainders">
        <span class="hint">On-remainders:</span>
        <% (0..9).each do |r| %>
          <label class="checkbox-pill">
            <%= check_box_tag "feature_flag[modulo_on_remainders][]", r, @flag.modulo_on_remainders.include?(r) %>
            <%= r %>
          </label>
        <% end %>
      </div>
      <p class="hint subtle">Tip: divisor=10 with one remainder = 10% rollout. Divisor=2 with one remainder = 50/50.</p>
    </fieldset>

    <div class="form-actions">
      <%= f.submit "Save", class: "btn-save" %>
      <%= link_to "Cancel", admin_feature_flags_path, class: "btn-cancel" %>
    </div>
  <% end %>
</div>
