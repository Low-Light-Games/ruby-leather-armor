<div class="feature-flags-page">
  <h1>Feature Flags</h1>
  <p class="page-desc">Per-user toggles. Granular and modulo bucketing are exclusive — pick one per flag.</p>

  <% if flash[:notice] %>
    <div class="flash-notice" onclick="this.style.display='none'"><%= flash[:notice] %></div>
    <script>setTimeout(function(){ var el = document.querySelector('.flash-notice'); if(el) el.style.display='none'; }, 4000);</script>
  <% end %>

  <% if @flags.empty? %>
    <p class="empty-msg">No feature flags defined.</p>
  <% else %>
    <table class="flags-table">
      <thead>
        <tr>
          <th class="col-key">Flag</th>
          <th class="col-desc">Description</th>
          <th class="col-mode">Mode</th>
          <th class="col-summary">Bucketing</th>
          <th class="col-action">Edit</th>
        </tr>
      </thead>
      <tbody>
        <% @flags.each do |flag| %>
          <tr class="row-mode-<%= flag.mode %>">
            <td class="col-key"><code><%= flag.key %></code></td>
            <td class="col-desc"><%= flag.description %></td>
            <td class="col-mode">
              <span class="flag-badge mode-<%= flag.mode %>"><%= flag.mode.upcase %></span>
            </td>
            <td class="col-summary">
              <%= bucket_summary(flag) %>
            </td>
            <td class="col-action">
              <%= link_to "Edit", edit_admin_feature_flag_path(flag), class: "btn-edit" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<style>
  .feature-flags-page {
    padding: 20px 30px;
    font-family: 'Arial', sans-serif;
    max-width: 1000px;
    margin: 0 auto;

    h1 {
      font-size: 24px;
      color: #333;
      margin: 0 0 6px;
    }
  }

  .page-desc { color: #666; font-size: 14px; margin-bottom: 24px; }

  .flash-notice {
    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
    z-index: 9999; padding: 12px 24px;
    background: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px;
    color: #155724; font-size: 14px; font-weight: 500;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15); cursor: pointer;
    animation: flashSlideIn 0.3s ease; max-width: 500px;
  }

  @keyframes flashSlideIn {
    from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .empty-msg { color: #888; font-style: italic; }

  .flags-table {
    width: 100%; border-collapse: collapse; font-size: 14px;

    th {
      text-align: left; padding: 10px 12px;
      background-color: #343a40; color: white;
      font-weight: 600; font-size: 12px;
      text-transform: uppercase; letter-spacing: 0.5px;
    }

    td { padding: 12px; border-bottom: 1px solid #e9ecef; vertical-align: middle; }

    .col-key {
      width: 220px;
      code { padding: 2px 8px; background: #f5f5f5; border: 1px solid #e0e0e0;
             border-radius: 4px; font-size: 13px; color: #333; }
    }
    .col-desc    { color: #555; font-size: 13px; line-height: 1.5; }
    .col-mode    { width: 90px; text-align: center; }
    .col-summary { color: #555; font-size: 12px; font-family: monospace; }
    .col-action  { width: 80px; text-align: center; }

    tr.row-mode-on       { background-color: #f1f8e9; }
    tr.row-mode-off      { background-color: #fff; }
    tr.row-mode-bucketed { background-color: #fff8e1; }
    tr:hover { background-color: #f5f5f5; }
  }

  .flag-badge {
    display: inline-block; padding: 3px 10px; border-radius: 10px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.5px;

    &.mode-on       { background-color: #c8e6c9; color: #2e7d32; }
    &.mode-off      { background-color: #e0e0e0; color: #757575; }
    &.mode-bucketed { background-color: #ffe0b2; color: #e65100; }
  }

  .btn-edit {
    display: inline-block; padding: 6px 14px;
    background: #1976d2; color: white;
    text-decoration: none; border-radius: 4px;
    font-size: 13px; font-weight: 600;
    transition: background 0.15s;
    &:hover { background: #1565c0; }
  }
</style>
