
<div class="pipelines-index">
  <div class="pipelines-header">
    <h1>Pipeline Logs</h1>
    <span class="total-count"><%= @total_count %> pipeline runs</span>
  </div>

  <% if @pipeline_runs.empty? %>
    <p class="empty-msg">No pipeline runs recorded yet. Pipeline logs appear once AI logs are linked to player messages.</p>
  <% else %>
    <table class="pipelines-table">
      <thead>
        <tr>
          <th class="col-time">Time</th>
          <th class="col-adv">Adv</th>
          <th class="col-message">Player Message</th>
          <th class="col-steps">Steps</th>
          <th class="col-status">Status</th>
          <th class="col-duration">Duration</th>
          <th class="col-models">Model(s)</th>
        </tr>
      </thead>
      <tbody>
        <% @pipeline_runs.each do |run| %>
          <% status = run[:status] %>
          <% is_retry = run[:retry_of].present? %>
          <tr class="pipeline-row pipeline-<%= status %><%= ' pipeline-retry' if is_retry %>">
            <td class="col-time">
              <a href="<%= pipeline_admin_play_logs_path(run[:pipeline_run_id]) %>" class="filter-link">
                <%= run[:first_at].strftime('%b %d %H:%M:%S') %>
              </a>
              <% if is_retry %>
                <span class="retry-label">retry</span>
              <% end %>
            </td>
            <td class="col-adv">
              <% if run[:adventure_id] %>
                <a href="<%= admin_play_logs_path(adventure_id: run[:adventure_id]) %>" class="filter-link">#<%= run[:adventure_id] %></a>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-message">
              <% if run[:message_content].present? %>
                <span class="player-msg-text"><%= truncate(run[:message_content], length: 80) %></span>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-steps">
              <div class="step-badges">
                <% run[:logs].each do |log| %>
                  <span class="type-badge type-mini <%= ai_log_type_badge_class(log.event_type) %> <%= 'step-error' if log.status.in?(PlayLog::STATUSES.reject { |s| s.in?(%w[success parse_fallback]) }) %>"><%= log.event_type.gsub('_', ' ').split.map { |w| w[0..2] }.join(' ') %></span>
                <% end %>
              </div>
            </td>
            <td class="col-status">
              <span class="pipeline-status-badge pipeline-<%= status %>"><%= status.capitalize %></span>
            </td>
            <td class="col-duration">
              <% pr = run[:pipeline_run] %>
              <% if pr && pr.active_duration_ms > 0 %>
                <span class="duration"><%= format_duration_ms(pr.active_duration_ms) %></span>
              <% elsif run[:first_at] && run[:last_at] %>
                <% duration_ms = ((run[:last_at].to_f - run[:first_at].to_f) * 1000).round %>
                <span class="duration"><%= format_duration_ms(duration_ms) %></span>
              <% end %>
            </td>
            <td class="col-models">
              <span class="models-text"><%= run[:logs].filter_map(&:model_used).uniq.join(', ') %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <a href="<%= pipelines_admin_play_logs_path(page: @page - 1) %>" class="page-link">← Prev</a>
        <% end %>
        <% (1..@total_pages).each do |p| %>
          <% if p == @page %>
            <span class="page-link current"><%= p %></span>
          <% elsif (p - @page).abs <= 3 || p == 1 || p == @total_pages %>
            <a href="<%= pipelines_admin_play_logs_path(page: p) %>" class="page-link"><%= p %></a>
          <% elsif (p - @page).abs == 4 %>
            <span class="page-link ellipsis">…</span>
          <% end %>
        <% end %>
        <% if @page < @total_pages %>
          <a href="<%= pipelines_admin_play_logs_path(page: @page + 1) %>" class="page-link">Next →</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>


<style>
  .pipelines-index {
    padding: 20px 30px; font-family: 'Arial', sans-serif; max-width: 1400px; margin: 0 auto;
  }
  .pipelines-header {
    display: flex; align-items: center; gap: 20px; margin-bottom: 20px;
    h1 { margin: 0; font-size: 24px; color: #333; }
  }
  .total-count { color: #888; font-size: 14px; }
  .empty-msg { color: #888; font-style: italic; }

  .pipelines-table {
    width: 100%; border-collapse: collapse; font-size: 13px;
    th {
      text-align: left; padding: 8px 10px; background-color: #343a40;
      color: white; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    td { padding: 10px 10px; border-bottom: 1px solid #e9ecef; vertical-align: middle; }
    .col-time { width: 110px; white-space: nowrap; font-family: monospace; font-size: 12px; }
    .col-adv { width: 50px; }
    .col-message { max-width: 250px; }
    .col-steps { max-width: 300px; }
    .col-status { width: 80px; }
    .col-duration { width: 70px; text-align: right; }
    .col-models { max-width: 180px; }
    .filter-link { color: #1565c0; text-decoration: none; &:hover { text-decoration: underline; } }
    tr:hover { background-color: #f5f5f5; }
    tr.pipeline-errored { background-color: #fce4ec; }
    tr.pipeline-incomplete, tr.pipeline-running { background-color: #fff3e0; }
    tr.pipeline-partial, tr.pipeline-paused { background-color: #fff8e1; }
    tr.pipeline-complete, tr.pipeline-completed { background-color: #f1f8e9; }
    tr.pipeline-retry { opacity: 0.65; }
  }

  .player-msg-text { font-size: 13px; color: #333; font-style: italic; }

  .step-badges { display: flex; flex-wrap: wrap; gap: 3px; }

  .type-badge {
    display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600;
    &.type-triage { background-color: #e0e0e0; color: #424242; }
    &.type-intent { background-color: #bbdefb; color: #0d47a1; }
    &.type-ruling { background-color: #ffe0b2; color: #e65100; }
    &.type-evaluate { background-color: #e1bee7; color: #6a1b9a; }
    &.type-narrate { background-color: #c8e6c9; color: #1b5e20; }
    &.type-dm-query { background-color: #b2dfdb; color: #004d40; }
    &.type-ctx { background-color: #f5f5f5; color: #616161; border: 1px solid #e0e0e0; }
    &.type-default { background-color: #f5f5f5; color: #757575; }
  }
  .type-mini { font-size: 10px; padding: 1px 6px; }
  .step-error { outline: 2px solid #ef5350; outline-offset: -1px; }

  .pipeline-status-badge {
    display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 600;
    &.pipeline-complete, &.pipeline-completed { background-color: #c8e6c9; color: #2e7d32; }
    &.pipeline-errored { background-color: #ffcdd2; color: #c62828; }
    &.pipeline-incomplete, &.pipeline-running { background-color: #ffe0b2; color: #e65100; }
    &.pipeline-partial, &.pipeline-paused { background-color: #fff9c4; color: #f57f17; }
  }

  .retry-label {
    display: inline-block; margin-left: 4px; padding: 1px 5px;
    border-radius: 3px; font-size: 9px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.3px;
    background-color: #e0e0e0; color: #757575;
    vertical-align: middle;
  }

  .duration { font-family: monospace; font-size: 12px; color: #666; }
  .models-text { font-size: 12px; color: #666; font-family: monospace; }
  .empty-cell { color: #bbb; }

  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 4px; margin-top: 20px; padding: 12px 0;
  }
  .page-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 32px; height: 32px; padding: 0 8px;
    border: 1px solid #dee2e6; border-radius: 4px;
    text-decoration: none; font-size: 13px; color: #495057; background: white; transition: all 0.15s;
    &:hover { background-color: #e9ecef; border-color: #adb5bd; }
    &.current { background-color: #007bff; border-color: #007bff; color: white; font-weight: 600; }
    &.ellipsis { border: none; background: none; cursor: default; }
  }
</style>
