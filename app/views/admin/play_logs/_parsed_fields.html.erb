<% if parsed.is_a?(Hash) %>
  <% parsed.each do |key, value| %>
    <div class="parsed-field">
      <span class="parsed-field-label"><%= key %></span>
      <% if value.is_a?(String) || value.is_a?(Numeric) || value.is_a?(TrueClass) || value.is_a?(FalseClass) || value.nil? %>
        <span class="parsed-field-value"><%= value.nil? ? "null" : value.to_s %></span>
      <% else %>
        <pre class="parsed-field-json"><%= JSON.pretty_generate(value) %></pre>
      <% end %>
    </div>
  <% end %>
<% end %>
