
<div class="admin-ai-logs-index">
  <div class="admin-logs-header">
    <h1>Play Logs</h1>
    <span class="total-count"><%= @total_count %> total</span>
    <div class="log-filters">
      <% if params[:adventure_id].present? %>
        <span class="filter-badge">
          Adventure #<%= params[:adventure_id] %>
          <a href="<%= admin_play_logs_path %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:status].present? %>
        <span class="filter-badge">
          Status: <%= params[:status] %>
          <a href="<%= admin_play_logs_path(request.query_parameters.except(:status)) %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:event_type].present? %>
        <span class="filter-badge">
          Type: <%= params[:event_type] %>
          <a href="<%= admin_play_logs_path(request.query_parameters.except(:event_type)) %>" class="clear-filter">✕</a>
        </span>
      <% end %>
    </div>
  </div>

  <div class="quick-filters">
    <strong>Status:</strong>
    <a href="<%= admin_play_logs_path(request.query_parameters.merge(status: 'success')) %>" class="qf <%= 'active' if params[:status] == 'success' %>">Success</a>
    <a href="<%= admin_play_logs_path(request.query_parameters.merge(status: 'parse_fallback')) %>" class="qf <%= 'active' if params[:status] == 'parse_fallback' %>">Fallback</a>
    <a href="<%= admin_play_logs_path(request.query_parameters.merge(status: 'parse_error')) %>" class="qf <%= 'active' if params[:status] == 'parse_error' %>">Parse Error</a>
    <a href="<%= admin_play_logs_path(request.query_parameters.merge(status: 'api_error')) %>" class="qf <%= 'active' if params[:status] == 'api_error' %>">API Error</a>
    <a href="<%= admin_play_logs_path(request.query_parameters.merge(status: 'token_budget_exceeded')) %>" class="qf <%= 'active' if params[:status] == 'token_budget_exceeded' %>">Budget Exceeded</a>
    &nbsp;|&nbsp;
    <strong>Type:</strong>
    <% PlayLog::EVENT_TYPES.each do |ct| %>
      <a href="<%= admin_play_logs_path(request.query_parameters.merge(event_type: ct)) %>" class="qf <%= 'active' if params[:event_type] == ct %>"><%= ct.humanize %></a>
    <% end %>
    &nbsp;|&nbsp;
    <% if @show_usage %>
      <a href="<%= admin_play_logs_path(request.query_parameters.except(:show_usage)) %>" class="qf active">Hide Usage</a>
    <% else %>
      <a href="<%= admin_play_logs_path(request.query_parameters.merge(show_usage: "1")) %>" class="qf">Show Usage</a>
    <% end %>
  </div>

  <% if @logs.empty? %>
    <p class="empty-msg">No AI logs yet.</p>
  <% else %>
    <table class="logs-table">
      <thead>
        <tr>
          <th class="col-time">Time</th>
          <th class="col-adventure">Adv</th>
          <th class="col-message">Message</th>
          <th class="col-type">Type</th>
          <th class="col-status">Status</th>
          <th class="col-prompt">Prompt</th>
          <th class="col-response">Response</th>
          <% if @show_usage %>
            <th class="col-tokens">Tokens</th>
            <th class="col-cost">Cost</th>
          <% end %>
          <th class="col-error">Error</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr class="<%= ai_log_status_class(log.status) %>">
            <td class="col-time">
              <a href="<%= admin_play_log_path(log) %>" class="filter-link"><%= log.created_at.strftime('%b %d %H:%M:%S') %></a>
            </td>
            <td class="col-adventure">
              <% if log.adventure_id %>
                <a href="<%= admin_play_logs_path(adventure_id: log.adventure_id) %>" class="filter-link">
                  #<%= log.adventure_id %>
                </a>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-message">
              <% if log.pipeline_run_id.present? %>
                <% tooltip = log.player_message&.content&.truncate(200) || log.player_message_content&.truncate(200) %>
                <a href="<%= pipeline_admin_play_logs_path(log.pipeline_run_id) %>" class="msg-link" title="<%= tooltip %>">
                  pipeline
                </a>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-type">
              <a href="<%= admin_play_logs_path(event_type: log.event_type) %>" class="filter-link">
                <span class="type-badge <%= ai_log_type_badge_class(log.event_type) %>"><%= log.event_type.humanize %></span>
              </a>
            </td>
            <td class="col-status">
              <span class="status-badge <%= log.status %>"><%= log.status.humanize %></span>
            </td>
            <td class="col-prompt"><%= truncate(log.prompt_summary, length: 200) %></td>
            <td class="col-response">
              <% if log.parsed_response.present? %>
                <button type="button" class="view-response-btn"
                        data-log-id="<%= log.id %>"
                        data-event-type="<%= log.event_type %>"
                        data-parsed='<%= log.parsed_response.gsub("'", "&#39;") %>'>View</button>
              <% elsif log.raw_response.present? %>
                <button type="button" class="view-response-btn"
                        data-log-id="<%= log.id %>"
                        data-event-type="<%= log.event_type %>"
                        data-raw='<%= log.raw_response.truncate(2000).gsub("'", "&#39;") %>'>View (raw)</button>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <% if @show_usage %>
              <td class="col-tokens">
                <% if log.ai_usage_record %>
                  <span class="tokens-text"><%= format_tokens(log.ai_usage_record.input_tokens) %> / <%= format_tokens(log.ai_usage_record.output_tokens) %></span>
                <% else %>
                  <span class="empty-cell">—</span>
                <% end %>
              </td>
              <td class="col-cost">
                <% if log.ai_usage_record %>
                  <span class="cost-text"><%= format_cost(log.ai_usage_record.total_cost_microdollars) %></span>
                <% else %>
                  <span class="empty-cell">—</span>
                <% end %>
              </td>
            <% end %>
            <td class="col-error">
              <% if log.error_message.present? %>
                <span class="error-text"><%= log.error_message %></span>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <a href="<%= admin_play_logs_path(request.query_parameters.merge(page: @page - 1)) %>" class="page-link">← Prev</a>
        <% end %>
        <% (1..@total_pages).each do |p| %>
          <% if p == @page %>
            <span class="page-link current"><%= p %></span>
          <% elsif (p - @page).abs <= 3 || p == 1 || p == @total_pages %>
            <a href="<%= admin_play_logs_path(request.query_parameters.merge(page: p)) %>" class="page-link"><%= p %></a>
          <% elsif (p - @page).abs == 4 %>
            <span class="page-link ellipsis">…</span>
          <% end %>
        <% end %>
        <% if @page < @total_pages %>
          <a href="<%= admin_play_logs_path(request.query_parameters.merge(page: @page + 1)) %>" class="page-link">Next →</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<div id="responseModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle"></h2>
      <button type="button" class="modal-close" onclick="closeResponseModal()">✕</button>
    </div>
    <div id="modalBody" class="modal-body"></div>
  </div>
</div>


<style>
  .admin-ai-logs-index {
    padding: 20px 30px;
    font-family: 'Arial', sans-serif;
    max-width: 1400px;
    margin: 0 auto;
  }

  .admin-logs-header {
    display: flex; align-items: center; gap: 20px; margin-bottom: 12px;
    h1 { margin: 0; font-size: 24px; color: #333; }
  }

  .total-count { color: #888; font-size: 14px; }

  .quick-filters {
    display: flex; align-items: center; gap: 6px; margin-bottom: 16px;
    font-size: 13px; flex-wrap: wrap;
    strong { color: #555; }
    .qf {
      padding: 3px 10px; border: 1px solid #dee2e6; border-radius: 14px;
      text-decoration: none; color: #495057; font-size: 12px; transition: all 0.15s;
      &:hover { background-color: #e9ecef; }
      &.active { background-color: #007bff; color: white; border-color: #007bff; }
    }
  }

  .log-filters { display: flex; gap: 8px; }

  .filter-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; background-color: #e3f2fd; border: 1px solid #90caf9;
    border-radius: 12px; font-size: 12px; color: #1565c0;
    .clear-filter { color: #c62828; text-decoration: none; font-weight: bold; &:hover { color: #b71c1c; } }
  }

  .empty-msg { color: #888; font-style: italic; }

  .logs-table {
    width: 100%; border-collapse: collapse; font-size: 13px;
    th {
      text-align: left; padding: 8px 10px; background-color: #343a40;
      color: white; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    td { padding: 8px 10px; border-bottom: 1px solid #e9ecef; vertical-align: top; }
    .col-time { width: 110px; white-space: nowrap; color: #666; font-family: monospace; font-size: 12px; }
    .col-adventure { width: 50px; }
    .col-message { width: 70px; }
    .col-type { width: 120px; }
    .col-status { width: 100px; }
    .col-prompt { width: 200px; word-break: break-word; }
    .col-response { width: 80px; }
    .col-tokens { width: 100px; font-family: monospace; font-size: 12px; }
    .col-cost { width: 70px; font-family: monospace; font-size: 12px; }
    .col-error { width: 150px; word-break: break-word; }
    .filter-link { color: #1565c0; text-decoration: none; &:hover { text-decoration: underline; } }
    tr.status-success { background-color: #f1f8e9; }
    tr.status-fallback { background-color: #fff8e1; }
    tr.status-error { background-color: #fce4ec; }
    tr:hover { background-color: #f5f5f5; }
  }

  .msg-link {
    color: #1565c0; text-decoration: none; font-family: monospace; font-size: 12px;
    border-bottom: 1px dashed #90caf9; cursor: pointer;
    &:hover { text-decoration: none; border-bottom-color: #1565c0; }
  }

  .status-badge {
    display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600;
    &.success { background-color: #c8e6c9; color: #2e7d32; }
    &.parse_fallback { background-color: #fff9c4; color: #f57f17; }
    &.parse_error { background-color: #ffcdd2; color: #c62828; }
    &.api_error { background-color: #ffcdd2; color: #c62828; }
    &.token_budget_exceeded { background-color: #ffcdd2; color: #c62828; }
  }

  .type-badge {
    display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600;
    &.type-triage { background-color: #e0e0e0; color: #424242; }
    &.type-intent { background-color: #bbdefb; color: #0d47a1; }
    &.type-ruling { background-color: #ffe0b2; color: #e65100; }
    &.type-evaluate { background-color: #e1bee7; color: #6a1b9a; }
    &.type-narrate { background-color: #c8e6c9; color: #1b5e20; }
    &.type-dm-query { background-color: #b2dfdb; color: #004d40; }
    &.type-ctx { background-color: #f5f5f5; color: #616161; border: 1px solid #e0e0e0; }
    &.type-default { background-color: #f5f5f5; color: #757575; }
  }

  .view-response-btn {
    padding: 3px 12px; border: 1px solid #90caf9; border-radius: 4px;
    background: #e3f2fd; color: #1565c0; font-size: 12px; cursor: pointer;
    transition: all 0.15s;
    &:hover { background: #bbdefb; }
  }

  .empty-cell { color: #bbb; }
  .error-text { color: #c62828; font-size: 12px; }
  .tokens-text { color: #555; }
  .cost-text { color: #2e7d32; font-weight: 600; }

  .modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); z-index: 1000;
    display: flex; align-items: center; justify-content: center;
  }
  .modal-content {
    background: white; border-radius: 8px; width: 90%; max-width: 800px;
    max-height: 85vh; display: flex; flex-direction: column;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
  }
  .modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 20px; border-bottom: 1px solid #e9ecef;
    h2 { margin: 0; font-size: 16px; color: #333; display: flex; align-items: center; gap: 10px; }
  }
  .modal-close {
    background: none; border: none; font-size: 20px; color: #999;
    cursor: pointer; padding: 4px 8px;
    &:hover { color: #333; }
  }
  .modal-body {
    padding: 20px; overflow-y: auto; font-size: 13px;
  }
  .modal-parsed-field {
    margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #f0f0f0;
    &:last-child { border-bottom: none; }
  }
  .modal-field-label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;
    color: #888; font-weight: 600; margin-bottom: 4px;
  }
  .modal-field-value { font-size: 13px; color: #333; line-height: 1.5; }
  .modal-field-json {
    font-size: 12px; font-family: 'Consolas', monospace;
    background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 4px;
    padding: 8px; white-space: pre-wrap; word-break: break-word;
    max-height: 200px; overflow-y: auto; margin-top: 4px;
  }
  .modal-full-json {
    margin-top: 16px;
    summary {
      font-size: 12px; color: #888; cursor: pointer; user-select: none;
      &:hover { color: #555; }
    }
    pre {
      font-size: 12px; font-family: 'Consolas', monospace;
      background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 4px;
      padding: 12px; white-space: pre-wrap; word-break: break-word;
      max-height: 400px; overflow-y: auto; margin-top: 8px;
    }
  }

  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 4px; margin-top: 20px; padding: 12px 0;
  }
  .page-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 32px; height: 32px; padding: 0 8px;
    border: 1px solid #dee2e6; border-radius: 4px;
    text-decoration: none; font-size: 13px; color: #495057; background: white; transition: all 0.15s;
    &:hover { background-color: #e9ecef; border-color: #adb5bd; }
    &.current { background-color: #007bff; border-color: #007bff; color: white; font-weight: 600; }
    &.ellipsis { border: none; background: none; cursor: default; }
  }
</style>

<script>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.view-response-btn');
    if (!btn) return;
    var logId = btn.dataset.logId;
    var eventType = btn.dataset.eventType;
    var parsedStr = btn.dataset.parsed;
    var rawStr = btn.dataset.raw;
    var title = document.getElementById('modalTitle');
    var body = document.getElementById('modalBody');
    var typeBadgeClass = {
      'triage': 'type-triage', 'sanitize': 'type-triage', 'classify': 'type-triage', 'intake': 'type-triage',
      'dispatcher': 'type-triage', 'beacon': 'type-triage', 'capability_guardrail': 'type-triage', 'sanity_checker': 'type-triage', 'sanity_checker_world': 'type-triage', 'chronicler': 'type-triage',
      'sequencer': 'type-intent', 'intent': 'type-intent', 'player_interpreter': 'type-intent', 'mechanical_evaluation': 'type-ruling', 'roll_qualifier': 'type-ruling',
      'ruling': 'type-evaluate', 'verdict': 'type-evaluate', 'mechanic': 'type-evaluate', 'momentum': 'type-evaluate', 'time_keeper': 'type-ctx',
      'narrate': 'type-narrate', 'dm_query': 'type-dm-query',
      'micro_context_update': 'type-ctx', 'macro_narrative_update': 'type-ctx',
      'edge_pipeline': 'type-narrate'
    }[eventType] || 'type-default';
    title.innerHTML = 'Play Log #' + logId + ' <span class="type-badge ' + typeBadgeClass + '">' + eventType.replace(/_/g, ' ') + '</span>';
    var html = '';
    if (parsedStr) {
      try {
        var parsed = JSON.parse(parsedStr);
        for (var key in parsed) {
          if (!parsed.hasOwnProperty(key)) continue;
          var val = parsed[key];
          html += '<div class="modal-parsed-field">';
          html += '<div class="modal-field-label">' + key + '</div>';
          if (typeof val === 'string' || typeof val === 'number' || typeof val === 'boolean' || val === null) {
            html += '<div class="modal-field-value">' + escapeHtml(String(val)) + '</div>';
          } else {
            html += '<pre class="modal-field-json">' + escapeHtml(JSON.stringify(val, null, 2)) + '</pre>';
          }
          html += '</div>';
        }
        html += '<details class="modal-full-json"><summary>Full JSON</summary>';
        html += '<pre>' + escapeHtml(JSON.stringify(parsed, null, 2)) + '</pre></details>';
      } catch(e) {
        html += '<pre class="modal-field-json">' + escapeHtml(parsedStr) + '</pre>';
      }
    } else if (rawStr) {
      html += '<pre class="modal-field-json">' + escapeHtml(rawStr) + '</pre>';
    }
    body.innerHTML = html;
    document.getElementById('responseModal').style.display = 'flex';
  });

  document.getElementById('responseModal').addEventListener('click', function(e) {
    if (e.target === this) closeResponseModal();
  });

  function closeResponseModal() {
    document.getElementById('responseModal').style.display = 'none';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeResponseModal();
  });

  function escapeHtml(text) {
    var el = document.createElement('div');
    el.textContent = text;
    return el.innerHTML;
  }
</script>
