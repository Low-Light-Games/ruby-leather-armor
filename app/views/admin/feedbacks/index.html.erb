<div class="admin-feedbacks-index">
  <div class="admin-feedbacks-header">
    <h1>Feedback</h1>
    <span class="total-count"><%= @total_count %> total</span>
  </div>

  <% if @feedbacks.empty? %>
    <p class="empty-msg">No feedback yet.</p>
  <% else %>
    <table class="feedbacks-table">
      <thead>
        <tr>
          <th class="col-time">Time</th>
          <th class="col-user">User</th>
          <th class="col-body">Message</th>
          <th class="col-page">Page</th>
        </tr>
      </thead>
      <tbody>
        <% @feedbacks.each do |fb| %>
          <tr>
            <td class="col-time">
              <a href="<%= admin_feedback_path(fb) %>" class="filter-link"><%= fb.created_at.strftime('%b %d %H:%M') %></a>
            </td>
            <td class="col-user"><%= fb.user&.email || "anonymous" %></td>
            <td class="col-body"><%= truncate(fb.body, length: 120) %></td>
            <td class="col-page"><%= fb.page_url %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <a href="<%= admin_feedbacks_path(page: @page - 1) %>" class="page-link">&larr; Prev</a>
        <% end %>
        <% (1..@total_pages).each do |p| %>
          <% if p == @page %>
            <span class="page-link current"><%= p %></span>
          <% elsif (p - @page).abs <= 3 || p == 1 || p == @total_pages %>
            <a href="<%= admin_feedbacks_path(page: p) %>" class="page-link"><%= p %></a>
          <% elsif (p - @page).abs == 4 %>
            <span class="page-link ellipsis">&hellip;</span>
          <% end %>
        <% end %>
        <% if @page < @total_pages %>
          <a href="<%= admin_feedbacks_path(page: @page + 1) %>" class="page-link">Next &rarr;</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<style>
  .admin-feedbacks-index {
    padding: 20px 30px;
    font-family: 'Arial', sans-serif;
    max-width: 1100px;
    margin: 0 auto;
  }

  .admin-feedbacks-header {
    display: flex; align-items: center; gap: 20px; margin-bottom: 16px;
    h1 { margin: 0; font-size: 24px; color: #333; }
  }

  .total-count { color: #888; font-size: 14px; }
  .empty-msg { color: #888; font-style: italic; }

  .feedbacks-table {
    width: 100%; border-collapse: collapse; font-size: 13px;
    th {
      text-align: left; padding: 8px 10px; background-color: #343a40;
      color: white; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    td { padding: 8px 10px; border-bottom: 1px solid #e9ecef; vertical-align: top; }
    .col-time { width: 110px; white-space: nowrap; color: #666; font-family: monospace; font-size: 12px; }
    .col-user { width: 180px; }
    .col-body { word-break: break-word; }
    .col-page { width: 200px; font-family: monospace; font-size: 12px; color: #666; word-break: break-all; }
    .filter-link { color: #1565c0; text-decoration: none; &:hover { text-decoration: underline; } }
    tr:hover { background-color: #f5f5f5; }
  }

  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 4px; margin-top: 20px; padding: 12px 0;
  }
  .page-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 32px; height: 32px; padding: 0 8px;
    border: 1px solid #dee2e6; border-radius: 4px;
    text-decoration: none; font-size: 13px; color: #495057; background: white; transition: all 0.15s;
    &:hover { background-color: #e9ecef; border-color: #adb5bd; }
    &.current { background-color: #007bff; border-color: #007bff; color: white; font-weight: 600; }
    &.ellipsis { border: none; background: none; cursor: default; }
  }
</style>
