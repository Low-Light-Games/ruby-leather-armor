<%= render 'admin/shared/navbar', active_nav: :encounters %>

<div class="admin-encounters-index">
  <div class="admin-logs-header">
    <h1>Combat Encounters</h1>
    <span class="total-count"><%= @total_count %> total</span>
    <div class="log-filters">
      <% if params[:adventure_id].present? %>
        <span class="filter-badge">
          Adventure #<%= params[:adventure_id] %>
          <a href="<%= admin_encounters_path %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:status].present? %>
        <span class="filter-badge">
          Status: <%= params[:status] %>
          <a href="<%= admin_encounters_path(request.query_parameters.except(:status)) %>" class="clear-filter">✕</a>
        </span>
      <% end %>
    </div>
  </div>

  <div class="quick-filters">
    <strong>Status:</strong>
    <a href="<%= admin_encounters_path(request.query_parameters.merge(status: 'active')) %>" class="qf <%= 'active' if params[:status] == 'active' %>">Active</a>
    <a href="<%= admin_encounters_path(request.query_parameters.merge(status: 'completed')) %>" class="qf <%= 'active' if params[:status] == 'completed' %>">Completed</a>
    <a href="<%= admin_encounters_path(request.query_parameters.merge(status: 'pending')) %>" class="qf <%= 'active' if params[:status] == 'pending' %>">Pending</a>
  </div>

  <% if @encounters.empty? %>
    <p class="empty-msg">No combat encounters yet.</p>
  <% else %>
    <table class="logs-table">
      <thead>
        <tr>
          <th class="col-id">ID</th>
          <th class="col-time">Started</th>
          <th class="col-adventure">Adventure</th>
          <th class="col-status">Status</th>
          <th class="col-rounds">Rounds</th>
          <th class="col-grid">Grid</th>
          <th class="col-participants">Participants</th>
          <th class="col-outcome">Outcome</th>
        </tr>
      </thead>
      <tbody>
        <% @encounters.each do |enc| %>
          <% players = enc.encounter_participants.select(&:player?) %>
          <% enemies = enc.encounter_participants.select(&:enemy?) %>
          <tr class="encounter-<%= enc.status %>">
            <td class="col-id">
              <a href="<%= admin_encounter_path(enc) %>" class="filter-link">#<%= enc.id %></a>
            </td>
            <td class="col-time"><%= enc.created_at.strftime('%b %d %H:%M:%S') %></td>
            <td class="col-adventure">
              <a href="<%= admin_encounters_path(adventure_id: enc.adventure_id) %>" class="filter-link">
                #<%= enc.adventure_id %>
              </a>
            </td>
            <td class="col-status">
              <span class="encounter-badge <%= enc.status %>"><%= enc.status.capitalize %></span>
            </td>
            <td class="col-rounds"><%= enc.round_number %></td>
            <td class="col-grid"><%= enc.grid_width %>x<%= enc.grid_height %></td>
            <td class="col-participants">
              <span class="team-players"><%= players.size %> player<%= players.size == 1 ? '' : 's' %></span>
              vs
              <span class="team-enemies"><%= enemies.size %> enem<%= enemies.size == 1 ? 'y' : 'ies' %></span>
              <div class="participant-names">
                <%= enemies.map { |e| e.name }.join(', ') %>
              </div>
            </td>
            <td class="col-outcome">
              <% if enc.completed? && enc.narrative_summary.present? %>
                <%= truncate(enc.narrative_summary, length: 120) %>
              <% elsif enc.active? %>
                <span class="in-progress-text">In progress...</span>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <a href="<%= admin_encounters_path(request.query_parameters.merge(page: @page - 1)) %>" class="page-link">← Prev</a>
        <% end %>
        <% (1..@total_pages).each do |p| %>
          <% if p == @page %>
            <span class="page-link current"><%= p %></span>
          <% elsif (p - @page).abs <= 3 || p == 1 || p == @total_pages %>
            <a href="<%= admin_encounters_path(request.query_parameters.merge(page: p)) %>" class="page-link"><%= p %></a>
          <% elsif (p - @page).abs == 4 %>
            <span class="page-link ellipsis">…</span>
          <% end %>
        <% end %>
        <% if @page < @total_pages %>
          <a href="<%= admin_encounters_path(request.query_parameters.merge(page: @page + 1)) %>" class="page-link">Next →</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%= render 'admin/shared/navbar_styles' %>

<style>
  .admin-encounters-index {
    padding: 20px 30px;
    font-family: 'Arial', sans-serif;
    max-width: 1400px;
    margin: 0 auto;
  }

  .admin-logs-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;

    h1 {
      margin: 0;
      font-size: 24px;
      color: #333;
    }
  }

  .total-count {
    color: #888;
    font-size: 14px;
  }

  .quick-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 13px;

    strong { color: #555; }

    .qf {
      padding: 3px 10px;
      border: 1px solid #dee2e6;
      border-radius: 14px;
      text-decoration: none;
      color: #495057;
      font-size: 12px;
      transition: all 0.15s;

      &:hover { background-color: #e9ecef; }
      &.active {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
      }
    }
  }

  .log-filters {
    display: flex;
    gap: 8px;
  }

  .filter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 12px;
    font-size: 12px;
    color: #1565c0;

    .clear-filter {
      color: #c62828;
      text-decoration: none;
      font-weight: bold;
      &:hover { color: #b71c1c; }
    }
  }

  .empty-msg {
    color: #888;
    font-style: italic;
  }

  .logs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;

    th {
      text-align: left;
      padding: 8px 10px;
      background-color: #343a40;
      color: white;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    td {
      padding: 8px 10px;
      border-bottom: 1px solid #e9ecef;
      vertical-align: top;
    }

    .col-id {
      width: 60px;
      font-family: monospace;
    }

    .col-time {
      width: 120px;
      white-space: nowrap;
      color: #666;
      font-family: monospace;
      font-size: 12px;
    }

    .col-adventure { width: 80px; }
    .col-status { width: 90px; }
    .col-rounds { width: 60px; text-align: center; }
    .col-grid { width: 70px; font-family: monospace; text-align: center; }

    .col-participants {
      width: 200px;
      word-break: break-word;
    }

    .col-outcome {
      max-width: 300px;
      word-break: break-word;
      font-size: 12px;
      color: #555;
    }

    .filter-link {
      color: #1565c0;
      text-decoration: none;
      &:hover { text-decoration: underline; }
    }

    tr.encounter-active { background-color: #fff8e1; }
    tr.encounter-completed { background-color: #f1f8e9; }
    tr.encounter-pending { background-color: #f5f5f5; }
    tr:hover { background-color: #eeeeee; }
  }

  .encounter-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;

    &.active {
      background-color: #fff9c4;
      color: #f57f17;
    }
    &.completed {
      background-color: #c8e6c9;
      color: #2e7d32;
    }
    &.pending {
      background-color: #e0e0e0;
      color: #616161;
    }
  }

  .team-players {
    color: #1565c0;
    font-weight: 600;
  }

  .team-enemies {
    color: #c62828;
    font-weight: 600;
  }

  .participant-names {
    font-size: 11px;
    color: #888;
    margin-top: 2px;
  }

  .in-progress-text {
    color: #f57f17;
    font-style: italic;
  }

  .empty-cell {
    color: #bbb;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    margin-top: 20px;
    padding: 12px 0;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    color: #495057;
    background: white;
    transition: all 0.15s;

    &:hover {
      background-color: #e9ecef;
      border-color: #adb5bd;
    }
    &.current {
      background-color: #007bff;
      border-color: #007bff;
      color: white;
      font-weight: 600;
    }
    &.ellipsis {
      border: none;
      background: none;
      cursor: default;
    }
  }
</style>
