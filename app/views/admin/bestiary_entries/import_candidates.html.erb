<%= render 'admin/shared/navbar', active_nav: :bestiary %>

<div class="import-page">
  <div class="import-header">
    <a href="<%= admin_bestiary_entries_path %>" class="back-link">← Back to Bestiary</a>
    <h1>Import AI Creatures into Bestiary</h1>
    <p class="import-desc">
      These creatures were generated by AI during adventures. Import them to make them
      available as bestiary entries for future encounters.
    </p>
  </div>

  <% if flash[:notice] %>
    <div class="flash-notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="flash-alert"><%= flash[:alert] %></div>
  <% end %>

  <% if @candidates.empty? %>
    <div class="empty-state">
      <p>No AI-generated creature sheets found.</p>
      <p class="sub">Creatures generated by the DM pipeline during adventures will appear here.</p>
    </div>
  <% else %>
    <div class="candidates-grid">
      <% @candidates.each do |candidate| %>
        <% sheet = candidate[:sheet] %>
        <% already = candidate[:already_in_bestiary] %>
        <div class="candidate-card <%= 'already-exists' if already %>">
          <div class="card-top">
            <h3><%= sheet.name %></h3>
            <span class="type-pill"><%= sheet.creature_type %></span>
            <% if already %>
              <span class="exists-pill">Already in bestiary</span>
            <% end %>
          </div>

          <div class="stats-grid">
            <div class="stat"><span class="stat-label">Level</span><span class="stat-val"><%= sheet.level %></span></div>
            <div class="stat"><span class="stat-label">HP</span><span class="stat-val"><%= sheet.hp %>/<%= sheet.max_hp %></span></div>
            <div class="stat"><span class="stat-label">AC</span><span class="stat-val"><%= sheet.derived_stats&.dig("ac") || '—' %></span></div>
            <div class="stat"><span class="stat-label">BAB</span><span class="stat-val"><%= sheet.derived_stats&.dig("bab") || '—' %></span></div>
          </div>

          <div class="abilities-row">
            <span>STR <strong><%= sheet.strength %></strong></span>
            <span>DEX <strong><%= sheet.dexterity %></strong></span>
            <span>CON <strong><%= sheet.constitution %></strong></span>
            <span>INT <strong><%= sheet.intelligence %></strong></span>
            <span>WIS <strong><%= sheet.wisdom %></strong></span>
            <span>CHA <strong><%= sheet.charisma %></strong></span>
          </div>

          <div class="card-meta">
            <span>Adventure #<%= sheet.adventure_id %></span>
            <span>×<%= candidate[:count] %> instance<%= candidate[:count] > 1 ? 's' : '' %></span>
          </div>

          <% unless already %>
            <%= form_tag import_admin_bestiary_entries_path, method: :post, class: "import-form" do %>
              <%= hidden_field_tag :creature_sheet_id, sheet.id %>
              <div class="form-row">
                <label for="bestiary_name_<%= sheet.id %>">Bestiary name:</label>
                <input type="text" name="bestiary_name" id="bestiary_name_<%= sheet.id %>"
                       value="<%= sheet.name %>" class="name-input" placeholder="Override name…" />
              </div>
              <button type="submit" class="btn btn-import-entry">Import to Bestiary</button>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
  .import-page { max-width: 1000px; margin: 20px auto; padding: 0 20px; font-family: system-ui, -apple-system, sans-serif; }
  .import-header { margin-bottom: 24px; }
  .import-header h1 { margin: 8px 0 4px; font-size: 1.4rem; color: #e0e0e0; }
  .import-desc { color: #9ca3af; font-size: 0.9rem; margin: 0; }
  .back-link { color: #60a5fa; text-decoration: none; font-size: 0.85rem; }
  .back-link:hover { text-decoration: underline; }

  .flash-notice { background: #064e3b; color: #6ee7b7; padding: 10px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem; }
  .flash-alert { background: #7f1d1d; color: #fca5a5; padding: 10px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem; }

  .empty-state { text-align: center; padding: 60px 20px; color: #6b7280; }
  .empty-state p { margin: 4px 0; }
  .empty-state .sub { font-size: 0.85rem; font-style: italic; }

  .candidates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 16px; }

  .candidate-card { background: #1a1a2e; border: 1px solid #2d2d44; border-radius: 8px; padding: 16px; }
  .candidate-card.already-exists { opacity: 0.55; }
  .card-top { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
  .card-top h3 { margin: 0; font-size: 1.1rem; color: #e0e0e0; }
  .type-pill { background: #374151; color: #d1d5db; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; text-transform: uppercase; font-weight: 600; }
  .exists-pill { background: #3b2f1e; color: #fbbf24; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; }

  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 10px; }
  .stat { background: #111122; padding: 6px 10px; border-radius: 4px; text-align: center; }
  .stat-label { display: block; font-size: 0.65rem; text-transform: uppercase; color: #6b7280; letter-spacing: 0.5px; }
  .stat-val { font-size: 0.95rem; font-weight: 600; color: #e0e0e0; }

  .abilities-row { display: flex; gap: 10px; font-size: 0.8rem; color: #9ca3af; margin-bottom: 10px; flex-wrap: wrap; }
  .abilities-row strong { color: #d1d5db; }

  .card-meta { display: flex; gap: 12px; font-size: 0.75rem; color: #6b7280; margin-bottom: 12px; }

  .import-form { border-top: 1px solid #2d2d44; padding-top: 12px; }
  .form-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .form-row label { font-size: 0.8rem; color: #9ca3af; white-space: nowrap; }
  .name-input { flex: 1; padding: 6px 10px; background: #111122; border: 1px solid #374151; border-radius: 4px; color: #e0e0e0; font-size: 0.85rem; }
  .name-input:focus { outline: none; border-color: #2563eb; }

  .btn-import-entry { display: inline-block; padding: 6px 14px; background: #2563eb; color: #fff; border: none; border-radius: 5px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
  .btn-import-entry:hover { background: #1d4ed8; }
</style>
