<%= render 'admin/shared/navbar', active_nav: :ai_logs %>

<div class="admin-ai-logs-index">
  <div class="admin-logs-header">
    <h1>AI Logs</h1>
    <span class="total-count"><%= @total_count %> total</span>
    <div class="log-filters">
      <% if params[:adventure_id].present? %>
        <span class="filter-badge">
          Adventure #<%= params[:adventure_id] %>
          <a href="<%= admin_ai_logs_path %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:status].present? %>
        <span class="filter-badge">
          Status: <%= params[:status] %>
          <a href="<%= admin_ai_logs_path(request.query_parameters.except(:status)) %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:call_type].present? %>
        <span class="filter-badge">
          Type: <%= params[:call_type] %>
          <a href="<%= admin_ai_logs_path(request.query_parameters.except(:call_type)) %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:dm_service].present? %>
        <span class="filter-badge">
          Service: <%= params[:dm_service] %>
          <a href="<%= admin_ai_logs_path(request.query_parameters.except(:dm_service)) %>" class="clear-filter">✕</a>
        </span>
      <% end %>
    </div>
  </div>

  <div class="quick-filters">
    <strong>Status:</strong>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(status: 'success')) %>" class="qf <%= 'active' if params[:status] == 'success' %>">✅ Success</a>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(status: 'parse_fallback')) %>" class="qf <%= 'active' if params[:status] == 'parse_fallback' %>">⚠️ Fallback</a>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(status: 'parse_error')) %>" class="qf <%= 'active' if params[:status] == 'parse_error' %>">❌ Parse Error</a>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(status: 'api_error')) %>" class="qf <%= 'active' if params[:status] == 'api_error' %>">💥 API Error</a>
    &nbsp;|&nbsp;
    <strong>Type:</strong>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(call_type: 'sanitization')) %>" class="qf <%= 'active' if params[:call_type] == 'sanitization' %>">🛡️ Sanitization</a>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(call_type: 'dm_response')) %>" class="qf <%= 'active' if params[:call_type] == 'dm_response' %>">🐉 DM Response</a>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(call_type: 'roll_response')) %>" class="qf <%= 'active' if params[:call_type] == 'roll_response' %>">🎲 Roll Response</a>
    <a href="<%= admin_ai_logs_path(request.query_parameters.merge(call_type: 'action_needs')) %>" class="qf <%= 'active' if params[:call_type] == 'action_needs' %>">🎯 Action Needs</a>
  </div>

  <% if @logs.empty? %>
    <p class="empty-msg">No AI logs yet.</p>
  <% else %>
    <table class="logs-table">
      <thead>
        <tr>
          <th class="col-time">Time</th>
          <th class="col-adventure">Adventure</th>
          <th class="col-service">Service</th>
          <th class="col-type">Type</th>
          <th class="col-status">Status</th>
          <th class="col-prompt">Prompt</th>
          <th class="col-response">Raw Response</th>
          <th class="col-error">Error</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr class="<%= ai_log_status_class(log.status) %>">
            <td class="col-time">
              <a href="<%= admin_ai_log_path(log) %>" class="filter-link"><%= log.created_at.strftime('%b %d %H:%M:%S') %></a>
            </td>
            <td class="col-adventure">
              <a href="<%= admin_ai_logs_path(adventure_id: log.adventure_id) %>" class="filter-link">
                #<%= log.adventure_id %>
              </a>
            </td>
            <td class="col-service">
              <a href="<%= admin_ai_logs_path(dm_service: log.dm_service) %>" class="filter-link">
                <span class="service-badge <%= log.dm_service %>"><%= log.dm_service.capitalize %></span>
              </a>
            </td>
            <td class="col-type">
              <a href="<%= admin_ai_logs_path(call_type: log.call_type) %>" class="filter-link">
                <%= log.call_type.humanize %>
              </a>
            </td>
            <td class="col-status">
              <span class="status-badge <%= log.status %>"><%= log.status.humanize %></span>
            </td>
            <td class="col-prompt"><%= truncate(log.prompt_summary, length: 200) %></td>
            <td class="col-response">
              <% if log.raw_response.present? %>
                <details>
                  <summary><%= truncate(log.raw_response, length: 80) %></summary>
                  <pre class="response-pre"><%= log.raw_response %></pre>
                </details>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-error">
              <% if log.error_message.present? %>
                <span class="error-text"><%= log.error_message %></span>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <a href="<%= admin_ai_logs_path(request.query_parameters.merge(page: @page - 1)) %>" class="page-link">← Prev</a>
        <% end %>
        <% (1..@total_pages).each do |p| %>
          <% if p == @page %>
            <span class="page-link current"><%= p %></span>
          <% elsif (p - @page).abs <= 3 || p == 1 || p == @total_pages %>
            <a href="<%= admin_ai_logs_path(request.query_parameters.merge(page: p)) %>" class="page-link"><%= p %></a>
          <% elsif (p - @page).abs == 4 %>
            <span class="page-link ellipsis">…</span>
          <% end %>
        <% end %>
        <% if @page < @total_pages %>
          <a href="<%= admin_ai_logs_path(request.query_parameters.merge(page: @page + 1)) %>" class="page-link">Next →</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%= render 'admin/shared/navbar_styles' %>

<style>
  .admin-ai-logs-index {
    padding: 20px 30px;
    font-family: 'Arial', sans-serif;
    max-width: 1400px;
    margin: 0 auto;
  }

  .admin-logs-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;

    h1 {
      margin: 0;
      font-size: 24px;
      color: #333;
    }
  }

  .total-count {
    color: #888;
    font-size: 14px;
  }

  .quick-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 13px;

    strong {
      color: #555;
    }

    .qf {
      padding: 3px 10px;
      border: 1px solid #dee2e6;
      border-radius: 14px;
      text-decoration: none;
      color: #495057;
      font-size: 12px;
      transition: all 0.15s;

      &:hover {
        background-color: #e9ecef;
      }

      &.active {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
      }
    }
  }

  .log-filters {
    display: flex;
    gap: 8px;
  }

  .filter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 12px;
    font-size: 12px;
    color: #1565c0;

    .clear-filter {
      color: #c62828;
      text-decoration: none;
      font-weight: bold;
      &:hover { color: #b71c1c; }
    }
  }

  .empty-msg {
    color: #888;
    font-style: italic;
  }

  .logs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;

    th {
      text-align: left;
      padding: 8px 10px;
      background-color: #343a40;
      color: white;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    td {
      padding: 8px 10px;
      border-bottom: 1px solid #e9ecef;
      vertical-align: top;
    }

    .col-time {
      width: 120px;
      white-space: nowrap;
      color: #666;
      font-family: monospace;
      font-size: 12px;
    }

    .col-adventure {
      width: 80px;
    }

    .col-service {
      width: 80px;
    }

    .col-type {
      width: 100px;
    }

    .col-status {
      width: 100px;
    }

    .col-prompt {
      width: 200px;
      word-break: break-word;
    }

    .col-response {
      max-width: 400px;
      word-break: break-word;
    }

    .col-error {
      width: 150px;
      word-break: break-word;
    }

    .filter-link {
      color: #1565c0;
      text-decoration: none;
      &:hover { text-decoration: underline; }
    }

    tr.status-success {
      background-color: #f1f8e9;
    }

    tr.status-fallback {
      background-color: #fff8e1;
    }

    tr.status-error {
      background-color: #fce4ec;
    }

    tr:hover {
      background-color: #f5f5f5;
    }
  }

  .status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;

    &.success {
      background-color: #c8e6c9;
      color: #2e7d32;
    }
    &.parse_fallback {
      background-color: #fff9c4;
      color: #f57f17;
    }
    &.parse_error {
      background-color: #ffcdd2;
      color: #c62828;
    }
    &.api_error {
      background-color: #ffcdd2;
      color: #c62828;
    }
  }

  .service-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;

    &.standard {
      background-color: #e3f2fd;
      color: #1565c0;
    }
  }

  .response-pre {
    margin-top: 8px;
    padding: 8px;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 11px;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 300px;
    overflow-y: auto;
  }

  .empty-cell {
    color: #bbb;
  }

  .error-text {
    color: #c62828;
    font-size: 12px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    margin-top: 20px;
    padding: 12px 0;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    color: #495057;
    background: white;
    transition: all 0.15s;

    &:hover {
      background-color: #e9ecef;
      border-color: #adb5bd;
    }

    &.current {
      background-color: #007bff;
      border-color: #007bff;
      color: white;
      font-weight: 600;
    }

    &.ellipsis {
      border: none;
      background: none;
      cursor: default;
    }

    &.disabled {
      opacity: 0.4;
      cursor: default;
    }
  }
</style>
