<%= render 'admin/shared/navbar', active_nav: :ai_logs %>

<div class="log-show">
  <div class="log-show-header">
    <a href="<%= admin_ai_logs_path %>" class="back-link">← Back to AI Logs</a>
    <h1>AI Log #<%= @log.id %></h1>
  </div>

  <div class="log-meta">
    <div class="meta-item">
      <span class="meta-label">Time</span>
      <span class="meta-value"><%= @log.created_at.strftime('%b %d, %Y %H:%M:%S') %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Adventure</span>
      <span class="meta-value">
        <a href="<%= admin_ai_logs_path(adventure_id: @log.adventure_id) %>">#<%= @log.adventure_id %></a>
      </span>
    </div>
    <div class="meta-item">
      <span class="meta-label">DM Service</span>
      <span class="meta-value"><%= @log.dm_service.capitalize %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Call Type</span>
      <span class="meta-value"><%= @log.call_type.humanize %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Status</span>
      <span class="status-badge <%= @log.status %>"><%= @log.status.humanize %></span>
    </div>
  </div>

  <% if @log.error_message.present? %>
    <div class="log-section error-section">
      <h2>Error</h2>
      <pre class="log-pre error-pre"><%= @log.error_message %></pre>
    </div>
  <% end %>

  <div class="log-section">
    <h2>Prompt Summary</h2>
    <pre class="log-pre"><%= @log.prompt_summary %></pre>
  </div>

  <div class="log-section">
    <h2>Request Body (what we sent to the AI)</h2>
    <% if @log.request_body.present? %>
      <pre class="log-pre"><%= begin; JSON.pretty_generate(JSON.parse(@log.request_body)); rescue; @log.request_body; end %></pre>
    <% else %>
      <p class="empty-cell">No request body captured (logged before this feature was added)</p>
    <% end %>
  </div>

  <div class="log-section">
    <h2>Raw AI Response</h2>
    <% if @log.raw_response.present? %>
      <pre class="log-pre"><%= @log.raw_response %></pre>
    <% else %>
      <p class="empty-cell">No raw response captured (API error before response)</p>
    <% end %>
  </div>

  <div class="log-section">
    <h2>Parsed Response</h2>
    <% if @log.parsed_response.present? %>
      <pre class="log-pre"><%= begin; JSON.pretty_generate(JSON.parse(@log.parsed_response)); rescue; @log.parsed_response; end %></pre>
    <% else %>
      <p class="empty-cell">No parsed response</p>
    <% end %>
  </div>
</div>

<%= render 'admin/shared/navbar_styles' %>
<%= render partial: 'admin/shared/log_show_styles' %>
