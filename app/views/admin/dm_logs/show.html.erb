<div class="app-header">
  <div class="user-info">
    <span>Logged in as: <%= current_user.email %></span>
    <% if current_user.admin? %><span class="admin-badge">Admin</span><% end %>
  </div>
  <div class="header-actions">
    <a href="/" class="nav-link">Sheets</a>
    <a href="/adventures/new" class="adventure-cta">Adventure!</a>
    <% if current_user.admin? %>
      <a href="/admin/stories" class="nav-link">Admin Stories</a>
      <a href="/admin/dm_logs" class="nav-link admin-logs-link">DM Logs</a>
      <a href="/admin/ai_logs" class="nav-link admin-logs-link">AI Logs</a>
    <% end %>
    <%= button_to "Logout", logout_path, method: :delete, class: "logout-link" %>
  </div>
</div>

<div class="log-show">
  <div class="log-show-header">
    <a href="<%= admin_dm_logs_path %>" class="back-link">← Back to DM Logs</a>
    <h1>DM Log #<%= @log.id %></h1>
  </div>

  <div class="log-meta">
    <div class="meta-item">
      <span class="meta-label">Time</span>
      <span class="meta-value"><%= @log.created_at.strftime('%b %d, %Y %H:%M:%S') %></span>
    </div>
    <div class="meta-item">
      <span class="meta-label">User</span>
      <span class="meta-value">
        <% if @log.user %>
          <a href="<%= admin_dm_logs_path(user_id: @log.user_id) %>"><%= @log.user.email %></a>
        <% else %>
          N/A
        <% end %>
      </span>
    </div>
    <div class="meta-item">
      <span class="meta-label">Adventure</span>
      <span class="meta-value">
        <a href="<%= admin_dm_logs_path(adventure_id: @log.adventure_id) %>">#<%= @log.adventure_id %></a>
      </span>
    </div>
  </div>

  <div class="log-section">
    <h2>Content</h2>
    <pre class="log-pre"><%= @log.content %></pre>
  </div>
</div>

<%= render partial: 'admin/shared/log_show_styles' %>
