<div class="app-header">
  <div class="user-info">
    <span>Logged in as: <%= current_user.email %></span>
    <% if current_user.admin? %><span class="admin-badge">Admin</span><% end %>
  </div>
  <div class="header-actions">
    <a href="/" class="nav-link">Sheets</a>
    <a href="/adventures/new" class="adventure-cta">Adventure!</a>
    <% if current_user.admin? %>
      <a href="/admin/stories" class="nav-link">Admin Stories</a>
      <a href="/admin/dm_logs" class="nav-link admin-logs-link">DM Logs</a>
      <a href="/admin/ai_logs" class="nav-link admin-logs-link">AI Logs</a>
    <% end %>
    <%= button_to "Logout", logout_path, method: :delete, class: "logout-link" %>
  </div>
</div>

<div class="admin-dm-logs-index">
  <div class="admin-logs-header">
    <h1>DM Logs</h1>
    <span class="total-count"><%= @total_count %> total</span>
    <div class="log-filters">
      <% if params[:adventure_id].present? %>
        <span class="filter-badge">
          Adventure #<%= params[:adventure_id] %>
          <a href="<%= admin_dm_logs_path %>" class="clear-filter">✕</a>
        </span>
      <% end %>
      <% if params[:user_id].present? %>
        <span class="filter-badge">
          User #<%= params[:user_id] %>
          <a href="<%= admin_dm_logs_path %>" class="clear-filter">✕</a>
        </span>
      <% end %>
    </div>
  </div>

  <% if @logs.empty? %>
    <p class="empty-msg">No logs yet.</p>
  <% else %>
    <table class="logs-table">
      <thead>
        <tr>
          <th class="col-time">Time</th>
          <th class="col-user">User</th>
          <th class="col-adventure">Adventure</th>
          <th class="col-content">Content</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr class="<%= log_row_class(log) %>">
            <td class="col-time">
              <a href="<%= admin_dm_log_path(log) %>" class="filter-link"><%= log.created_at.strftime('%b %d %H:%M:%S') %></a>
            </td>
            <td class="col-user">
              <a href="<%= admin_dm_logs_path(user_id: log.user_id) %>" class="filter-link">
                <%= log.user.email.split('@').first %>
              </a>
            </td>
            <td class="col-adventure">
              <a href="<%= admin_dm_logs_path(adventure_id: log.adventure_id) %>" class="filter-link">
                #<%= log.adventure_id %>
              </a>
            </td>
            <td class="col-content"><%= log.content %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <a href="<%= admin_dm_logs_path(request.query_parameters.merge(page: @page - 1)) %>" class="page-link">← Prev</a>
        <% end %>
        <% (1..@total_pages).each do |p| %>
          <% if p == @page %>
            <span class="page-link current"><%= p %></span>
          <% elsif (p - @page).abs <= 3 || p == 1 || p == @total_pages %>
            <a href="<%= admin_dm_logs_path(request.query_parameters.merge(page: p)) %>" class="page-link"><%= p %></a>
          <% elsif (p - @page).abs == 4 %>
            <span class="page-link ellipsis">…</span>
          <% end %>
        <% end %>
        <% if @page < @total_pages %>
          <a href="<%= admin_dm_logs_path(request.query_parameters.merge(page: @page + 1)) %>" class="page-link">Next →</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<style>
  .admin-dm-logs-index {
    padding: 20px 30px;
    font-family: 'Arial', sans-serif;
    max-width: 1200px;
    margin: 0 auto;
  }

  .admin-logs-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;

    h1 {
      margin: 0;
      font-size: 24px;
      color: #333;
    }
  }

  .total-count {
    color: #888;
    font-size: 14px;
  }

  .log-filters {
    display: flex;
    gap: 8px;
  }

  .filter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 12px;
    font-size: 12px;
    color: #1565c0;

    .clear-filter {
      color: #c62828;
      text-decoration: none;
      font-weight: bold;
      &:hover { color: #b71c1c; }
    }
  }

  .empty-msg {
    color: #888;
    font-style: italic;
  }

  .logs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;

    th {
      text-align: left;
      padding: 8px 10px;
      background-color: #343a40;
      color: white;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    td {
      padding: 8px 10px;
      border-bottom: 1px solid #e9ecef;
      vertical-align: top;
    }

    .col-time {
      width: 130px;
      white-space: nowrap;
      color: #666;
      font-family: monospace;
      font-size: 12px;
    }

    .col-user {
      width: 120px;
    }

    .col-adventure {
      width: 90px;
    }

    .col-content {
      line-height: 1.5;
      word-break: break-word;
    }

    .filter-link {
      color: #1565c0;
      text-decoration: none;
      &:hover { text-decoration: underline; }
    }

    tr.log-sanitized {
      background-color: #fff8e1;
    }

    tr.log-malicious {
      background-color: #fce4ec;
    }

    tr.log-dm-response {
      background-color: #fff;
    }

    tr.log-passed {
      background-color: #f1f8e9;
    }

    tr:hover {
      background-color: #f5f5f5;
    }
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    margin-top: 20px;
    padding: 12px 0;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    color: #495057;
    background: white;
    transition: all 0.15s;

    &:hover {
      background-color: #e9ecef;
      border-color: #adb5bd;
    }

    &.current {
      background-color: #007bff;
      border-color: #007bff;
      color: white;
      font-weight: 600;
    }

    &.ellipsis {
      border: none;
      background: none;
      cursor: default;
    }

    &.disabled {
      opacity: 0.4;
      cursor: default;
    }
  }

  /* Navbar — same as stories index */
  .app-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background-color: #343a40;
    color: white;
    font-family: 'Arial', sans-serif;
    margin-bottom: 20px;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .admin-badge {
    background-color: #ffc107;
    color: #343a40;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: bold;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .nav-link {
    color: white;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: color 0.15s;
    &:hover { color: #cccccc; }
  }

  .adventure-cta {
    background-color: #007bff;
    color: white;
    padding: 8px 16px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: background-color 0.15s;
    &:hover { background-color: #0056b3; }
  }

  .admin-logs-link {
    color: #ff9800;
    &:hover { color: #e65100; }
  }

  .logout-link {
    padding: 8px 16px;
    background: none;
    border: none;
    color: #dc3545;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s;
    &:hover { color: #a71d2a; text-decoration: underline; }
  }
</style>
