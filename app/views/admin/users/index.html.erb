<div class="users-index">
  <div class="users-header">
    <h1>Users</h1>
    <span class="total-count"><%= @users.size %> users</span>
  </div>

  <% if @users.empty? %>
    <p class="empty-msg">No users found.</p>
  <% else %>
    <table class="users-table">
      <thead>
        <tr>
          <th class="col-id">#</th>
          <th class="col-email">Email</th>
          <th class="col-tier">Tier</th>
          <th class="col-strikes">Strikes</th>
          <th class="col-trusted">Trusted</th>
          <th class="col-banned">Banned</th>
          <th class="col-joined">Joined</th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="<%= "banned-row" if user.banned? %>">
            <td class="col-id">
              <a href="<%= admin_user_path(user) %>" class="user-link">#<%= user.id %></a>
            </td>
            <td class="col-email">
              <a href="<%= admin_user_path(user) %>" class="user-link"><%= user.email %></a>
              <% if user.admin? %><span class="badge badge-admin">admin</span><% end %>
            </td>
            <td class="col-tier"><span class="tier-badge tier-<%= user.tier %>"><%= user.tier %></span></td>
            <td class="col-strikes">
              <span class="<%= "strikes-warning" if user.moderation_strikes > 0 %>">
                <%= user.moderation_strikes %>
              </span>
            </td>
            <td class="col-trusted">
              <% if user.trusted? %>
                <span class="badge badge-trusted">trusted</span>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-banned">
              <% if user.banned? %>
                <span class="badge badge-banned">banned</span>
                <span class="banned-at"><%= user.banned_at&.strftime('%b %d %H:%M') %></span>
              <% else %>
                <span class="empty-cell">—</span>
              <% end %>
            </td>
            <td class="col-joined"><%= user.created_at.strftime('%b %d %Y') %></td>
            <td class="col-actions">
              <% if user.banned? %>
                <%= button_to "Unban", unban_admin_user_path(user), method: :patch,
                      class: "btn-action btn-unban" %>
              <% else %>
                <%= button_to "Ban", ban_admin_user_path(user), method: :patch,
                      data: { confirm: "Ban #{user.email}? They will lose access to all AI features." },
                      class: "btn-action btn-ban" %>
              <% end %>
              <% if user.trusted? %>
                <%= button_to "Revoke Trust", untrust_admin_user_path(user), method: :patch,
                      class: "btn-action btn-untrust" %>
              <% else %>
                <%= button_to "Trust", trust_admin_user_path(user), method: :patch,
                      class: "btn-action btn-trust" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<style>
  .users-index {
    padding: 20px 30px; font-family: 'Arial', sans-serif; max-width: 1400px; margin: 0 auto;
  }
  .users-header {
    display: flex; align-items: center; gap: 20px; margin-bottom: 20px;
    h1 { margin: 0; font-size: 24px; color: #333; }
  }
  .total-count { color: #888; font-size: 14px; }
  .empty-msg { color: #888; font-style: italic; }

  .users-table {
    width: 100%; border-collapse: collapse; font-size: 13px;
    th {
      text-align: left; padding: 8px 10px; background-color: #343a40;
      color: white; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    td { padding: 10px 10px; border-bottom: 1px solid #e9ecef; vertical-align: middle; }
    tr:hover { background-color: #f5f5f5; }
    tr.banned-row { background-color: #fff5f5; }
    tr.banned-row:hover { background-color: #ffebeb; }
  }
  .user-link { color: #1565c0; text-decoration: none; font-weight: 600; &:hover { text-decoration: underline; } }
  .badge {
    display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 11px; font-weight: 600;
    margin-left: 4px;
  }
  .badge-admin    { background: #e3f2fd; color: #1565c0; }
  .badge-trusted  { background: #e8f5e9; color: #2e7d32; }
  .badge-banned   { background: #ffebee; color: #c62828; }
  .tier-badge     { display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .tier-free      { background: #f5f5f5; color: #555; }
  .tier-paid      { background: #fff8e1; color: #e65100; }
  .strikes-warning { color: #c62828; font-weight: 700; }
  .banned-at      { font-size: 11px; color: #888; margin-left: 4px; }
  .empty-cell     { color: #bbb; }

  .col-id      { width: 50px; }
  .col-email   { max-width: 260px; }
  .col-tier    { width: 70px; }
  .col-strikes { width: 70px; text-align: center; }
  .col-trusted { width: 90px; }
  .col-banned  { width: 150px; }
  .col-joined  { width: 110px; white-space: nowrap; font-family: monospace; font-size: 12px; color: #666; }
  .col-actions { width: 220px; text-align: right; }

  .btn-action {
    border: none; padding: 4px 10px; border-radius: 4px; font-size: 12px;
    cursor: pointer; font-weight: 600; white-space: nowrap; margin-left: 4px;
  }
  .btn-ban     { background: #c62828; color: white; &:hover { background: #b71c1c; } }
  .btn-unban   { background: #2e7d32; color: white; &:hover { background: #1b5e20; } }
  .btn-trust   { background: #1565c0; color: white; &:hover { background: #0d47a1; } }
  .btn-untrust { background: #e65100; color: white; &:hover { background: #bf360c; } }
</style>
