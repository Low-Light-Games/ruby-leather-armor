<div class="user-show">
  <div class="user-header">
    <h1><%= @user.email %></h1>
    <div class="user-badges">
      <% if @user.admin? %><span class="badge badge-admin">admin</span><% end %>
      <% if @user.trusted? %><span class="badge badge-trusted">trusted</span><% end %>
      <% if @user.banned? %><span class="badge badge-banned">banned</span><% end %>
      <span class="tier-badge tier-<%= @user.plan_key %>"><%= @user.plan_key %></span>
    </div>
  </div>

  <div class="user-meta">
    <div class="meta-item"><strong>ID:</strong> #<%= @user.id %></div>
    <div class="meta-item"><strong>Joined:</strong> <%= @user.created_at.strftime('%b %d, %Y %H:%M UTC') %></div>
    <div class="meta-item"><strong>Strikes:</strong> <span class="<%= "strikes-warning" if @user.moderation_strikes > 0 %>"><%= @user.moderation_strikes %></span></div>
    <% if @user.banned_at %>
      <div class="meta-item"><strong>Banned at:</strong> <%= @user.banned_at.strftime('%b %d, %Y %H:%M UTC') %></div>
    <% end %>
  </div>

  <div class="user-actions">
    <% if @user.banned? %>
      <%= button_to "Unban User", unban_admin_user_path(@user), method: :patch,
            class: "btn-action btn-unban" %>
    <% else %>
      <%= button_to "Ban User", ban_admin_user_path(@user), method: :patch,
            data: { confirm: "Ban #{@user.email}? They will lose access to all AI features." },
            class: "btn-action btn-ban" %>
    <% end %>
    <% if @user.trusted? %>
      <%= button_to "Revoke Trust", untrust_admin_user_path(@user), method: :patch,
            class: "btn-action btn-untrust" %>
    <% else %>
      <%= button_to "Grant Trust", trust_admin_user_path(@user), method: :patch,
            class: "btn-action btn-trust" %>
    <% end %>
    <%= link_to "← Back to Users", admin_users_path, class: "back-link" %>
  </div>

  <h2>Moderation History</h2>

  <% if @moderation_events.empty? %>
    <p class="empty-msg">No moderation events recorded.</p>
  <% else %>
    <table class="events-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Strike #</th>
          <th>Auto-banned</th>
          <th>Flagged Categories</th>
          <th>Input Excerpt</th>
        </tr>
      </thead>
      <tbody>
        <% @moderation_events.each do |event| %>
          <tr>
            <td><%= event.created_at.strftime('%b %d %H:%M') %></td>
            <td>#<%= event.strike_number %></td>
            <td><%= event.auto_banned? ? "Yes" : "—" %></td>
            <td>
              <% flagged = event.flagged_categories.select { |_, v| v }.keys %>
              <%= flagged.any? ? flagged.join(", ") : "—" %>
            </td>
            <td class="excerpt"><%= truncate(event.input_excerpt, length: 120) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<style>
  .user-show {
    padding: 20px 30px; font-family: 'Arial', sans-serif; max-width: 1200px; margin: 0 auto;
  }
  .user-header {
    display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
    h1 { margin: 0; font-size: 24px; color: #333; }
  }
  .user-badges { display: flex; gap: 6px; align-items: center; }
  .badge {
    display: inline-block; padding: 3px 9px; border-radius: 10px; font-size: 12px; font-weight: 600;
  }
  .badge-admin    { background: #e3f2fd; color: #1565c0; }
  .badge-trusted  { background: #e8f5e9; color: #2e7d32; }
  .badge-banned   { background: #ffebee; color: #c62828; }
  .tier-badge     { display: inline-block; padding: 3px 9px; border-radius: 10px; font-size: 12px; font-weight: 600; }
  .tier-free      { background: #f5f5f5; color: #555; }
  .tier-novice      { background: #fff8e1; color: #e65100; }
  .tier-scout       { background: #eef2ff; color: #3730a3; }
  .tier-adventurer  { background: #ecfeff; color: #155e75; }
  .user-meta {
    display: flex; gap: 24px; background: #f8f9fa; padding: 14px 18px;
    border-radius: 6px; margin-bottom: 20px; font-size: 14px;
    .meta-item { color: #555; }
    strong { color: #333; }
  }
  .strikes-warning { color: #c62828; font-weight: 700; }
  .user-actions { display: flex; gap: 8px; align-items: center; margin-bottom: 28px; }
  .back-link { margin-left: auto; color: #555; font-size: 13px; text-decoration: none; &:hover { text-decoration: underline; } }
  .btn-action {
    border: none; padding: 7px 14px; border-radius: 4px; font-size: 13px;
    cursor: pointer; font-weight: 600; white-space: nowrap;
  }
  .btn-ban     { background: #c62828; color: white; &:hover { background: #b71c1c; } }
  .btn-unban   { background: #2e7d32; color: white; &:hover { background: #1b5e20; } }
  .btn-trust   { background: #1565c0; color: white; &:hover { background: #0d47a1; } }
  .btn-untrust { background: #e65100; color: white; &:hover { background: #bf360c; } }
  .empty-msg { color: #888; font-style: italic; }
  h2 { font-size: 18px; color: #333; margin-bottom: 12px; }
  .events-table {
    width: 100%; border-collapse: collapse; font-size: 13px;
    th {
      text-align: left; padding: 8px 10px; background-color: #343a40;
      color: white; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    td { padding: 10px; border-bottom: 1px solid #e9ecef; vertical-align: top; }
    tr:hover { background-color: #f5f5f5; }
    .excerpt { color: #555; font-style: italic; max-width: 400px; }
  }
</style>
