# Database
POSTGRES_PASSWORD=
DATABASE_URL=postgres://exercises:PASSWORD@localhost:5432/exercises_development

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=
DM_OPENAI_MAX_RETRIES=2
DM_OPENAI_RETRY_BASE_DELAY_SECONDS=0.5
DM_OPENAI_RETRY_MAX_DELAY_SECONDS=8
DM_EVALUATOR_HTTP_MAX_RETRIES=1
DM_EVALUATOR_HTTP_RETRY_BASE_DELAY_SECONDS=0.25
DM_EVALUATOR_HTTP_RETRY_MAX_DELAY_SECONDS=1

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly one of the Authorized redirect URIs in Google Console
# Dev:  http://localhost:3000/auth/google_oauth2/callback
# Prod: https://YOUR_DOMAIN/auth/google_oauth2/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google_oauth2/callback

# Reddit OAuth
# Register at: https://www.reddit.com/prefs/apps (type: "web app")
# Note: Reddit may require developer approval under the Responsible Builder Policy
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_OAUTH_REDIRECT_URI=http://localhost:3000/auth/reddit/callback

# Discord OAuth
# Register at: https://discord.com/developers/applications > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Twitch OAuth
# Register at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_OAUTH_REDIRECT_URI=http://localhost:3000/auth/twitchtv/callback

# Rails, production only
RAILS_MASTER_KEY=

# Resend (email, production only)
RESEND_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Axiom + S3 (all environments — omit to disable shipping)
AXIOM_API_KEY=
AXIOM_DATASET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Sentry (error tracking, production only)
SENTRY_DSN=
