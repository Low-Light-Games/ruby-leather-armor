# Database
POSTGRES_PASSWORD=
DATABASE_URL=postgres://exercises:PASSWORD@localhost:5432/exercises_development

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly one of the Authorized redirect URIs in Google Console.
# OmniAuth is mounted at /app/auth. On the subdomain, nginx adds /app/ automatically,
# so the public-facing callback URL has no /app/ prefix.
# Dev:  http://localhost:3000/app/auth/google_oauth2/callback
# Prod: https://app.leatherarmor.io/auth/google_oauth2/callback  (nginx adds /app/)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/app/auth/google_oauth2/callback

# Canonical URL for the player app — used to redirect users after Google OAuth.
# Without this, the post-auth redirect falls back to /app (fine for local dev).
# Prod: APP_URL=https://app.leatherarmor.io
APP_URL=

# Rails, production only
RAILS_MASTER_KEY=

# Resend (email, production only)
RESEND_API_KEY=

# Axiom + S3 (all environments — omit to disable shipping)
AXIOM_API_KEY=
AXIOM_DATASET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Sentry (error tracking, production only)
SENTRY_DSN=